# Copy this file to collector/.env. The copied file is gitignored.

# Local canonical cache. The default is under ~/Library/Application Support.
# COLLECTOR_DB_PATH=/Users/your-name/Library/Application Support/Portanahung/market-data.sqlite3

# Source holdings are fetched directly from these public Google Sheet tabs.
# Reading Railway here would create a stale-replica feedback loop.
GOOGLE_SHEET_ID=1XsHYx1Ifb-y2jX2mssDCB7ICW4YnhEsjWiDi3F3UIdE
PORTFOLIOS=CUB,PSC,DBS,FT

# Fresh/intraday quote provider. Never commit the real token.
MARKETDATA_TOKEN=replace-with-your-marketdata-token

# Destination database ingestion API. Configure this same random secret as
# RAILWAY_INGEST_TOKEN on Railway. Never commit the real value.
RAILWAY_BASE_URL=https://portanahunggoogsheet-production.up.railway.app
RAILWAY_INGEST_TOKEN=replace-with-a-long-random-secret

# 550 calendar days retains ample history for 60 trading-session analysis.
YFINANCE_BACKFILL_DAYS=550
YFINANCE_CHUNK_SIZE=25
MARKETDATA_QUOTE_CHUNK_SIZE=100
MARKETDATA_CACHE_MAXAGE_SECONDS=300
SYNC_BATCH_SIZE=500
REQUEST_TIMEOUT_SECONDS=30

# The launchd tick runs every five minutes. These gates avoid unnecessary work.
HOLDINGS_REFRESH_MINUTES=15
HISTORY_RETRY_MINUTES=30
