<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rolandtalk.portanahung-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/railway</string>
    <string>run</string>
    <string>--project</string>
    <string>__RAILWAY_PROJECT_ID__</string>
    <string>--environment</string>
    <string>production</string>
    <string>--service</string>
    <string>portanahunggoogsheet</string>
    <string>--no-local</string>
    <string>__RUNTIME_PATH__/.venv/bin/python</string>
    <string>-m</string>
    <string>collector.cli</string>
    <string>scheduled</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__RUNTIME_PATH__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME_PATH__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__LOG_PATH__/collector.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_PATH__/collector-error.log</string>
</dict>
</plist>
